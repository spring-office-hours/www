# Transistor.fm API
TRANSISTOR_API_KEY=your_transistor_api_key
TRANSISTOR_SHOW_ID=your_show_id

# GitHub Discussions for potluck questions
# A fine-grained token with Discussions read and write on the repo below.
GITHUB_TOKEN=your_github_token
GITHUB_DISCUSSIONS_REPO=spring-office-hours/www
GITHUB_DISCUSSIONS_CATEGORY=Q&A
# Set to true to log questions instead of posting them.
POTLUCK_DRY_RUN=false

# Site URL (for SEO)
SITE_URL=https://springofficehours.io
